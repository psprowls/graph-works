{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["type", "title", "description", "work_status", "opened", "updated"],
  "additionalProperties": true,
  "properties": {
    "type": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "stable", "deprecated"] },
    "work_status": {
      "enum": ["open", "accepted", "in-progress", "mitigated", "resolved", "wontfix", "superseded"]
    },
    "phase": { "enum": ["design", "plan", "execute", "finish", "done"] },
    "effort": { "enum": ["xtra-small", "small", "medium", "large", "xtra-large"] },
    "opened": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "affects": { "type": "array", "items": { "type": "string" } },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "blocks", "needs"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^work/(?:_archive/)?[a-z0-9]+(?:-[a-z0-9]+)*(?:/children/(?:_archive/)?[a-z0-9]+(?:-[a-z0-9]+)*)*$"
          },
          "blocks": { "enum": ["design", "plan", "execute", "finish"] },
          "needs": { "enum": ["design", "plan", "execute", "finish", "resolved"] }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "blast_radius": { "enum": ["file", "package", "domain", "system"] },
    "target": { "type": "string", "pattern": "^([0-9]{4}-Q[1-4]|[0-9]{4}-(0[1-9]|1[0-2]))$" },
    "owner": { "type": "string", "minLength": 1 },
    "resolved_in": { "type": "string", "minLength": 1 },
    "released_at": { "type": "string", "format": "date" },
    "worktree": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "superseded_by": { "type": "string", "minLength": 1 },
    "mitigation": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "resource"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "resource": { "type": "string", "pattern": "^/", "minLength": 1 },
          "title": { "type": "string" },
          "last_modified": { "type": "string", "format": "date" }
        }
      }
    }
  },
  "if": { "properties": { "status": { "const": "draft" } }, "required": ["status"] },
  "then": {},
  "else": { "required": ["effort", "affects"] },
  "x-okf-directory": "work/"
}
