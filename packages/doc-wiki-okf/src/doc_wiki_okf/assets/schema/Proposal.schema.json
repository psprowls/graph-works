{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["type", "title", "target", "page_status", "sources"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "Proposal" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "target": { "type": "string", "minLength": 1 },
    "target_type": { "type": "string", "minLength": 1 },
    "page_status": { "enum": ["proposed", "approved", "rejected", "superseded", "created"] },
    "superseded_by": { "type": "string", "minLength": 1 },
    "verified": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["by", "at"],
        "additionalProperties": true,
        "properties": { "by": { "type": "string", "minLength": 1 }, "at": { "type": "string" } }
      }
    },
    "generated": { "type": "object" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "resource"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "resource": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "x-okf-directory": "proposals/",
  "x-okf-accept-proposals": false
}
