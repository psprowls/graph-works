#!/usr/bin/env bash
# PreToolUse hook on Skill: point graph-works workflow spec/plan/guidance
# artifacts at the per-item working directory. Mirrors hooks/session-start's
# escaping and 3-way platform JSON branching. Fail-open: never blocks a Skill call.
#
# Resolution is pure bash, via skills/shared/resolve-workspace.sh, and the
# projection is read with sed. Both are deliberate: this hook ships into the
# installed plugin tree (~/.claude/plugins/.../graph-works/hooks), where there
# is no uv project to run a Python stack in and no guarantee of jq.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

allow() {
    if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
        printf '{"additional_context": ""}\n'
    else
        printf '{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "allow"}}\n'
    fi
}

# Fail-open on any unexpected error.
trap 'allow; exit 0' ERR

INPUT=$(cat)

# Fast path: only the doc-writing / pipeline skills matter. Cheap match on the
# raw payload — no jq, no workspace resolution for any other skill.
# Match is deliberately payload-wide (not name-scoped): trading a rare spurious resolution for independence from the skill-id field name and namespacing.
if ! printf '%s' "$INPUT" | grep -qE '(brainstorming|writing-plans|workflow|onboard)'; then
    allow; exit 0
fi

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# emit <context> <system-message>
# Either may be empty. An empty context emits the bare allow shape — the same
# body `allow` prints — so a branch with nothing to inject never advertises an
# empty additionalContext key.
emit() {
    local context="$1" message="$2" body
    if [ -n "$context" ]; then
        local context_escaped
        context_escaped=$(escape_for_json "$context")
        # Cursor expects additional_context (snake_case); Claude Code expects nested
        # hookSpecificOutput.additionalContext; Copilot/SDK expect top-level.
        if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
            body=$(printf '"additional_context": "%s"' "$context_escaped")
        elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
            body=$(printf '"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "allow", "additionalContext": "%s"}' "$context_escaped")
        else
            body=$(printf '"additionalContext": "%s"' "$context_escaped")
        fi
    elif [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
        body='"additional_context": ""'
    else
        body='"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "allow"}'
    fi

    if [ -n "$message" ]; then
        local message_escaped
        message_escaped=$(escape_for_json "$message")
        printf '{%s, "systemMessage": "%s"}\n' "$body" "$message_escaped"
    else
        printf '{%s}\n' "$body"
    fi
}

# sha256 of a file, by whichever tool is present. Empty when none is — the
# freshness check then asks for refresh rather than silently assuming freshness.
sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" 2>/dev/null | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$1" 2>/dev/null | awk '{print $NF}'
    else
        printf ''
    fi
}

# Decode machine-generated JSON path strings without executing their contents.
# ensure_ascii=False leaves non-ASCII characters literal; escaped controls use
# the JSON short escapes or \u00xx, all supported by the Bash 3 printf builtin.
decode_json_path() {
    local raw="$1" char hex i=0
    DECODED_PATH=""
    while [ "$i" -lt "${#raw}" ]; do
        char="${raw:$i:1}"
        i=$((i + 1))
        if [ "$char" = '\' ]; then
            char="${raw:$i:1}"
            i=$((i + 1))
            case "$char" in
                '"'|'\'|'/') ;;
                b) char=$'\b' ;;
                f) char=$'\f' ;;
                n) char=$'\n' ;;
                r) char=$'\r' ;;
                t) char=$'\t' ;;
                u)
                    hex="${raw:$i:4}"
                    [[ "$hex" == 00[0-9a-fA-F][0-9a-fA-F] ]] && [ "$hex" != 0000 ] || return 1
                    printf -v char '%b' "\\x${hex:2:2}"
                    i=$((i + 4))
                    ;;
                *) return 1 ;;
            esac
        fi
        DECODED_PATH="$DECODED_PATH$char"
    done
}

WORKSPACE=$(bash "$SCRIPT_DIR/../skills/shared/resolve-workspace.sh" 2>/dev/null) || WORKSPACE=""

# No workspace at all: a repository that has never had one set up is the
# ordinary case, not a misconfiguration. Stay silent rather than warn on every
# matching Skill call.
if [ -z "$WORKSPACE" ]; then
    allow; exit 0
fi

# A named root that is NOT a workspace is a real misconfiguration the user can
# act on, so it keeps the systemMessage. The marker check lives here rather
# than in the shared resolver, whose contract is "resolve the directory" and
# whose other consumer depends on it not checking.
#
# The message names the missing marker and stops short of naming a verb that
# creates it, because the `gw` on PATH before the cutover is still the donor
# CLI, whose `bootstrap` builds a vault (`raw/` and `work/` siblings, an
# out-of-repo workspace env var), not a `workspace.yaml`. graph-works-cli's own
# `bootstrap` does write one — it wraps `graph_works_core.workspace.init` — so
# the verb name `gw bootstrap` is correct on one side of the cutover and wrong
# on the other, which is exactly why it cannot be named here. The marker file is
# true on both. The tests assert the absence of all three candidate verbs so the
# omission is deliberate and stays that way until the cutover epic makes one
# `gw` unambiguous.
if [ ! -f "$WORKSPACE/workspace.yaml" ]; then
    emit "" "gw: $WORKSPACE is not a graph-works workspace — it has no workspace.yaml marker — so brainstorming/writing-plans/workflow output will NOT be routed to a per-item working directory. Point GRAPH_WORKS_DIR at a workspace that has one, or unset it to fall back to <repo>/.works discovery."
    exit 0
fi

# The projection records workspace and dispatch inputs, including absent local
# files. Missing/old metadata always asks for refresh. Hash every declared input;
# the hook neither reads YAML nor evaluates dispatch rules.
#
# The path is hardcoded rather than resolved, and that is a known limit: a
# workspace overriding `layout.config_dir` (and, since it derives from that,
# `layout.cache_dir`) keeps its projection somewhere else and this hook falls
# back to the defaults for all of it. Resolving the override is circular — the
# override lives in the manifest, and reading the manifest is the YAML parse
# this hook exists to avoid.
PROJECTION="$WORKSPACE/.gw/cache/config.json"
BUNDLE_DIR="okf"
STALE_NOTICE=""

if [ -f "$PROJECTION" ]; then
    # `bundle_dir` appears only under `layout` in the manifest catalog, and the
    # file is machine-generated by json.dumps(indent=2, ensure_ascii=False), so its shape is stable.
    # Known limit: a bundle_dir containing an escaped quote falls back to the
    # default rather than parsing wrong.
    projected_bundle=$(sed -n 's/.*"bundle_dir"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$PROJECTION" 2>/dev/null | head -n 1)
    if [ -n "$projected_bundle" ]; then
        BUNDLE_DIR="$projected_bundle"
    fi

    # Machine-generated input records only: no YAML reader or rule matcher.
    # Fail conservatively if metadata cannot be interpreted by this shell.
    records=$(awk '
        /^    "dispatch_inputs": \{/ { inside=1; next }
        inside && /^    }/ { inside=0 }
        inside && /^      "(manifest|manifest_local|shared|local)": \{/ { name=$0; path=""; exists=""; hash=""; count++ }
        inside && /"path":/ { path=$0; sub(/^ *"path": "/,"",path); sub(/",?$/,"",path) }
        inside && /"exists":/ { exists=$0; sub(/^ *"exists": /,"",exists); sub(/,$/,"",exists) }
        inside && /"sha256":/ { hash=$0; sub(/^ *"sha256": /,"",hash); gsub(/[",]/,"",hash) }
        inside && /^      }/ { printf "%s\t%s\t%s\n", path, exists, hash }
        END { if(count != 4) print "INVALID" }
    ' "$PROJECTION")
    stale_inputs=""
    while IFS=$'\t' read -r input_path input_exists input_sha; do
        if [ -z "$input_path" ] || [ "$input_path" = "INVALID" ] || [[ "$input_path" != /* ]]; then
            stale_inputs="$stale_inputs metadata"
            continue
        fi
        if ! decode_json_path "$input_path"; then
            stale_inputs="$stale_inputs metadata"
            continue
        fi
        input_path="$DECODED_PATH"
        if [ "$input_exists" = "true" ]; then
            actual=$(sha256_of "$input_path") || actual=""
            if [ ! -f "$input_path" ] || [ -z "$actual" ] || [ "$actual" != "$input_sha" ]; then
                stale_inputs="$stale_inputs $input_path"
            fi
        elif [ "$input_exists" != "false" ] || [ "$input_sha" != "null" ] || [ -e "$input_path" ]; then
            stale_inputs="$stale_inputs $input_path"
        fi
    done <<< "$records"
    if [ -n "$stale_inputs" ]; then
        STALE_NOTICE="<graph-works-config-stale> Configuration inputs changed or freshness metadata is incomplete:$stale_inputs. Hooks read $PROJECTION. Run: \`gw config sync\`"
    fi
else
    STALE_NOTICE="<graph-works-config-stale> Configuration projection $PROJECTION is missing. Run: \`gw config sync\`"
fi

context="GRAPH-WORKS WORKSPACE ROUTING: graph-works workflow artifacts belong beneath each canonical work item's owned references directory. \`gw work file\` creates the owned directory. If pipeline-dispatched, use the exact \`artifact.path\` from the brief. In standalone auto-file mode, read \`path\` from \`gw work file --json\` and write design -> $WORKSPACE/$BUNDLE_DIR/<work-path>/references/01-design.md or plan -> $WORKSPACE/$BUNDLE_DIR/<work-path>/references/02-plan.md."

# AUTO-FILE. The trigger for the procedure that used to live inside a patched
# copy of obra's brainstorming/SKILL.md. The mode check stays model-side: this
# hook sees the Skill tool payload, not the prompt a dispatch brief was composed
# into, so it cannot decide the mode itself. The three anchor points are carried
# inline so a session that never opens the companion skill still does the right
# thing at each of the three moments.
context="$context

AUTO-FILE (standalone brainstorming only). MODE CHECK FIRST: if this invocation carries a work-item brief (a title / kind / summary block) or the line \"STOP after writing the spec\", a work item already exists — ignore this clause entirely and run the ordinary flow. Otherwise this is standalone, and on the Architectural path only: (1) FILE NOW — before the clarifying questions, invoke the \`gw:file\` skill in auto-file mode (its \"Auto-file mode (hook-triggered)\" section) to file the item and capture its canonical path; (2) AT SPEC TIME — write the design to $WORKSPACE/$BUNDLE_DIR/<work-path>/references/01-design.md and run \`gw work advance <work-path> --effort <confirmed-effort>\`; (3) TERMINAL — STOP: do not invoke writing-plans; end with \"Phase advanced. Clear context (/clear) and run /gw:workflow <work-path> to continue.\" If the confirmed kind is Epic or Release, stop right after step (1) instead: emit \"Filed as <work-path>. Clear context (/clear) and run /gw:workflow <work-path> to continue.\" and do not continue the design."

emit "$context" "$STALE_NOTICE"
exit 0
