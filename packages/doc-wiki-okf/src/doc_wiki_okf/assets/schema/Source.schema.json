{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["type", "title", "description", "source_path"],
  "additionalProperties": true,
  "properties": {
    "type": { "const": "Source" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "source_kind": { "enum": ["spec", "article", "ticket", "skill", "doc", "transcript", "code-review"] },
    "source_path": { "type": "string", "minLength": 1, "x-okf-member": true },
    "origin": { "type": "string" },
    "ingested": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "source_date": { "type": "string", "format": "date" },
    "authors": { "type": "array", "items": { "type": "string" } },
    "entity_uri": { "type": "string" },
    "tokens": { "type": "integer" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "object" } }
  },
  "x-okf-directory": "sources/"
}
