{
  "schema_version": 1,
  "server": "graph-works-serve",
  "version": "0.3.12",
  "response_headers": [
    {
      "name": "X-GW-Generation",
      "on": "every JSON GET and every successful apply",
      "summary": "The sidecar read generation the response reflects: the snapshot's for memo-served reads, otherwise the generation current when the request began (a lower bound)."
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/v1/agent-config",
      "summary": "Each coding agent's configuration layers, trust and effective values.",
      "params": [
        {
          "name": "project",
          "type": "str",
          "required": false,
          "default": null,
          "location": "query",
          "summary": "Report this one directory instead of the workspace's projects."
        },
        {
          "name": "agent",
          "type": "csv",
          "required": false,
          "default": null,
          "location": "query",
          "summary": "Limit to agents: claude,codex,pi."
        }
      ],
      "response": "json"
    },
    {
      "method": "GET",
      "path": "/v1/code-graph/neighborhood",
      "summary": "A code-graph page's depends-on/used-by neighbourhood to depth 1-3 (cap 200 nodes); not live.",
      "params": [
        {
          "name": "id",
          "type": "str",
          "required": true,
          "default": null,
          "location": "query",
          "summary": "Extensionless bundle-relative page id."
        },
        {
          "name": "depth",
          "type": "int",
          "required": false,
          "default": 1,
          "location": "query",
          "summary": "Hops, 1-3."
        }
      ],
      "response": "json"
    },
    {
      "method": "GET",
      "path": "/v1/code-graph/search",
      "summary": "Code-graph pages matching a term: exact title, then title prefix, then any substring.",
      "params": [
        {
          "name": "q",
          "type": "str",
          "required": true,
          "default": null,
          "location": "query",
          "summary": "Search term, case-insensitive."
        },
        {
          "name": "repo",
          "type": "str",
          "required": false,
          "default": null,
          "location": "query",
          "summary": "Limit to one declared repository."
        },
        {
          "name": "limit",
          "type": "int",
          "required": false,
          "default": 50,
          "location": "query",
          "summary": "Maximum hits."
        }
      ],
      "response": "json"
    },
    {
      "method": "GET",
      "path": "/v1/code-graph/tree",
      "summary": "Every page under one repository's code-graph folder, index documents included, as a flat parent-linked list.",
      "params": [
        {
          "name": "repo",
          "type": "str",
          "required": true,
          "default": null,
          "location": "query",
          "summary": "Declared repository name."
        }
      ],
      "response": "json"
    },
    {
      "method": "GET",
      "path": "/v1/code/excerpt",
      "summary": "Lines of a declared repository's tracked file around a cited range (5 lines context, 400-line cap).",
      "params": [
        {
          "name": "repo",
          "type": "str",
          "required": true,
          "default": null,
          "location": "query",
          "summary": "Declared repository name."
        },
        {
          "name": "path",
          "type": "str",
          "required": true,
          "default": null,
          "location": "query",
          "summary": "Repo-relative POSIX file path."
        },
        {
          "name": "start",
          "type": "int",
          "required": true,
          "default": null,
          "location": "query",
          "summary": "First cited line, 1-based."
        },
        {
          "name": "end",
          "type": "int",
          "required": false,
          "default": null,
          "location": "query",
          "summary": "Last cited line; defaults to start."
        }
      ],
      "response": "json"
    },
    {
      "method": "GET",
      "path": "/v1/config",
      "summary": "Every resolved config key, or one key's value and origin.",
      "params": [
        {
          "name": "key",
          "type": "str",
          "required": false,
          "default": null,
          "location": "query",
          "summary": "One catalog key; omit to list all."
        }
      ],
      "response": "json"
    },
    {
      "method": "GET",
      "path": "/v1/dispatch/explain",
      "summary": "Why an item resolves to its dispatch profile, rule by rule (equal to /v1/work/next's dispatch).",
      "params": [
        {
          "name": "path",
          "type": "str",
          "required": true,
          "default": null,
          "location": "query",
          "summary": "Extensionless bundle-relative canonical concept path."
        }
      ],
      "response": "json"
    },
    {
      "method": "GET",
      "path": "/v1/dispatch/rules",
