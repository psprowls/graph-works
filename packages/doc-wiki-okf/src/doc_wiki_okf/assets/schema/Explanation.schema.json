{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "_base-diataxis.schema.json",
  "unevaluatedProperties": false,
  "properties": {
    "type": { "const": "Explanation" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "_base-diataxis.schema.json#/$defs/entry" },
          { "properties": { "id": { "pattern": "^C[1-9][0-9]*$" } } }
        ]
      }
    }
  },
  "x-okf-directory": "docs/explanations/",
  "x-okf-about": { "entries": "claims" }
}
